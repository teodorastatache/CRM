generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Integration {
  id          String   @id @default(cuid())
  provider    String   @unique
  shopDomain  String?
  accessToken String
  scope       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Sume agregate per platformă/lună din Oblio — populate periodic de un job
// de sincronizare, ca vizualizarea "An" din Facturi și încasări să nu mai
// citească live toate facturile (volum prea mare pentru un singur request).
model OblioMonthlyTotal {
  id              String   @id @default(cuid())
  year            Int
  month           Int
  platform        String
  sumaFacturata   Float
  sumaIncasata    Float
  numarFacturi    Int
  lastSyncedAt    DateTime @default(now())

  @@unique([year, month, platform])
}

// Facturile individuale de fulfillment și call center — volum mic (~20-25/lună),
// spre deosebire de eMAG/Trendyol/Site, așa că le păstrăm pe fiecare, sincronizate
// de același job, ca să poată fi afișate și pentru vizualizarea "An".
model OblioServiceInvoice {
  id            String   @id
  platform      String
  referinta     String
  dataFacturii  String
  dataScadenta  String
  sumaFacturata Float
  sumaIncasata  Float
  status        String
  updatedAt     DateTime @updatedAt

  @@index([platform])
}

model ComandaMare {
  id                 String   @id
  furnizor           String
  produse            String
  cantitate          Int
  dataPlecare        String
  dataSosireEstimata String
  valoare            Float
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ComandaAvion {
  id                 String   @id
  furnizor           String
  produse            String
  cantitate          Int
  awb                String
  dataPlecare        String
  dataSosireEstimata String
  valoare            Float
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ComandaPending {
  id           String   @id
  furnizor     String
  produse      String
  valoare      Float
  motivPending String
  dataCreare   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transport {
  id                 String   @id
  furnizor           String
  produse            String
  cantitate          Int
  tip                String
  dataPlecare        String
  dataEstimataSosire String
  valoare            Float
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
