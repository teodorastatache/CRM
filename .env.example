# Bază de date Postgres (Neon, Supabase, etc.) — pe Vercel se completează automat
# dacă adaugi integrarea de bază de date din marketplace-ul Vercel.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret pentru semnarea sesiunilor NextAuth. Generează unul unic cu:
#   openssl rand -base64 33
AUTH_SECRET="schimbă-mă"
